Adds SSL_CTX_set_extension_order_tail: extensions that a client sends last in
the ClientHello, after the ones ordered by SSL_CTX_set_extension_order,
SSL_CTX_set_permute_extensions or the default order. NSS (Firefox) permutes its
QUIC ClientHello extensions but always ends with quic_transport_parameters and
encrypted_client_hello. pre_shared_key still comes last.

diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index b3d62f0..40bd792 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5313,6 +5313,16 @@ OPENSSL_EXPORT int SSL_CTX_set_extension_order(SSL_CTX *ctx, const uint16_t *ids
 OPENSSL_EXPORT void SSL_CTX_set_tls13_legacy_extensions(SSL_CTX *ctx,
                                                         int enabled);
 
+// SSL_CTX_set_extension_order_tail configures extensions that clients on |ctx|
+// send last in the ClientHello, in the order of |ids|. All other extensions
+// come first, in the order that results from |SSL_CTX_set_extension_order|,
+// |SSL_CTX_set_permute_extensions| or the default. Only the GREASE, padding and
+// pre_shared_key extensions still follow them. Unknown IDs are ignored. It
+// returns one on success and zero on allocation failure.
+OPENSSL_EXPORT int SSL_CTX_set_extension_order_tail(SSL_CTX *ctx,
+                                                    const uint16_t *ids,
+                                                    size_t num_ids);
+
 // SSL_set_record_size_limit configures whether sockets on |ssl| should
 // send record size limit extension.
 OPENSSL_EXPORT void SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index c400861..8a91245 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -3922,6 +3922,45 @@ static const struct tls_extension *tls_extension_find(uint32_t *out_index,
   return nullptr;
 }
 
+bool ssl_apply_extension_order_tail(SSL_HANDSHAKE *hs) {
+  const Array<uint16_t> &tail = hs->ssl->ctx->extension_order_tail;
+  if (tail.empty()) {
+    return true;
+  }
+
+  bool pinned[kNumExtensions] = {false};
+  uint8_t pinned_order[kNumExtensions];
+  size_t num_pinned = 0;
+  for (uint16_t id : tail) {
+    uint32_t index;
+    if (tls_extension_find(&index, id) == nullptr || pinned[index]) {
+      continue;
+    }
+    pinned[index] = true;
+    pinned_order[num_pinned++] = static_cast<uint8_t>(index);
+  }
+
+  Array<uint8_t> permutation;
+  if (!permutation.InitForOverwrite(kNumExtensions)) {
+    return false;
+  }
+  size_t num_written = 0;
+  for (size_t unpermuted = 0; unpermuted < kNumExtensions; unpermuted++) {
+    size_t i = hs->extension_permutation.empty()
+                   ? unpermuted
+                   : hs->extension_permutation[unpermuted];
+    if (!pinned[i]) {
+      permutation[num_written++] = static_cast<uint8_t>(i);
+    }
+  }
+  for (size_t i = 0; i < num_pinned; i++) {
+    permutation[num_written++] = pinned_order[i];
+  }
+  assert(num_written == kNumExtensions);
+  hs->extension_permutation = std::move(permutation);
+  return true;
+}
