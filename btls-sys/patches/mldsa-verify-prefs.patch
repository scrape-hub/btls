+int SSL_CTX_set_advertised_verify_algorithm_prefs(SSL_CTX *ctx,
+                                                  const uint16_t *prefs,
+                                                  size_t num_prefs) {
+  return set_sigalg_prefs(&FromOpaque(ctx)->verify_sigalgs,
+                          Span(prefs, num_prefs), /*allow_unknown=*/true);
+}
+
+int SSL_set_advertised_verify_algorithm_prefs(SSL *ssl, const uint16_t *prefs,
+                                              size_t num_prefs) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+
+  return set_sigalg_prefs(&ssl_impl->config->verify_sigalgs,
+                          Span(prefs, num_prefs), /*allow_unknown=*/true);
+}
