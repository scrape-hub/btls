diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index 06464767..b31e6e8b 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -1119,6 +1119,14 @@ int SSL_set_quic_transport_params(SSL *ssl, const uint8_t *params,
                                  Span(params, params_len));
 }
 
+int SSL_set_quic_transport_params_outer(SSL *ssl, const uint8_t *params,
+                                        size_t params_len) {
+  auto *ssl_impl = FromOpaque(ssl);
+  return ssl_impl->config &&
+         ssl_impl->config->quic_transport_params_outer.CopyFrom(
+             Span(params, params_len));
+}
