Adds SSL_CTX_set_tls13_legacy_extensions: send extended_master_secret and
renegotiation_info in a ClientHello that only offers TLS 1.3, as NSS does
(Firefox, including over QUIC).

diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 6e7b435..b3d62f0 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5306,6 +5306,13 @@ OPENSSL_EXPORT void SSL_set_permute_extensions(SSL *ssl, int enabled);
 // order instead of a random one.
 OPENSSL_EXPORT int SSL_CTX_set_extension_order(SSL_CTX *ctx, const uint16_t *ids, int num);
 
+// SSL_CTX_set_tls13_legacy_extensions configures whether clients on |ctx| send
+// the extended_master_secret and renegotiation_info extensions in a
+// ClientHello that only offers TLS 1.3. They have no effect in TLS 1.3 and are
+// omitted by default, but NSS always sends them, including over QUIC.
+OPENSSL_EXPORT void SSL_CTX_set_tls13_legacy_extensions(SSL_CTX *ctx,
+                                                        int enabled);
+
 // SSL_set_record_size_limit configures whether sockets on |ssl| should
 // send record size limit extension.
 OPENSSL_EXPORT void SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index e229aaa..c400861 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -672,7 +672,8 @@ static bool ext_ri_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
                                    ssl_client_hello_type_t type) {
   const SSL *const ssl = hs->ssl;
   // Renegotiation indication is not necessary in TLS 1.3.
-  if (hs->min_version >= TLS1_3_VERSION ||  //
+  if ((hs->min_version >= TLS1_3_VERSION &&
+       !ssl->ctx->tls13_legacy_extensions) ||
      type == ssl_client_hello_inner ||
      (SSL_get_options(hs->ssl) & SSL_OP_NO_RENEGOTIATION)) {
     return true;
@@ -830,7 +831,9 @@ static bool ext_ems_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
                                     CBB *out_compressible,
                                     ssl_client_hello_type_t type) {
   // Extended master secret is not necessary in TLS 1.3.
-  if (hs->min_version >= TLS1_3_VERSION || type == ssl_client_hello_inner) {
+  if ((hs->min_version >= TLS1_3_VERSION &&
+       !hs->ssl->ctx->tls13_legacy_extensions) ||
+      type == ssl_client_hello_inner) {
     return true;
   }
 
diff --git a/ssl/internal.h b/ssl/internal.h
index de67716..7b371ef 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -4105,6 +4105,10 @@ struct ssl_ctx_st : public bssl::RefCounted<ssl_ctx_st> {
   // It is only effective on the client side.
   bool preserve_tls13_cipher_list : 1;
 
+  // tls13_legacy_extensions is whether a client sends extended_master_secret
+  // and renegotiation_info even if it only offers TLS 1.3.
+  bool tls13_legacy_extensions : 1;
+
   // tls13_cipher_list, if non-null, is the list of ciphers to use in TLS 1.3
   bssl::UniquePtr<bssl::SSLCipherPreferenceList> tls13_cipher_list;
 
diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index b923493..9d46118 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -406,7 +406,8 @@ ssl_ctx_st::ssl_ctx_st(const SSL_METHOD *ssl_method)
       aes_hw_override(false),
       aes_hw_override_value(false),
       resumption_across_names_enabled(false),
-      preserve_tls13_cipher_list(false) {
+      preserve_tls13_cipher_list(false),
+      tls13_legacy_extensions(false) {
   CRYPTO_MUTEX_init(&lock);
   CRYPTO_new_ex_data(&ex_data);
 }
@@ -3183,6 +3184,10 @@ int SSL_CTX_set_extension_order(SSL_CTX *ctx, const uint16_t *ids, int num) {
   return 1;
 }
 
+void SSL_CTX_set_tls13_legacy_extensions(SSL_CTX *ctx, int enabled) {
+  ctx->tls13_legacy_extensions = !!enabled;
+}
+
 int32_t SSL_get_ticket_age_skew(const SSL *ssl) {
   return ssl->s3->ticket_age_skew;
 }
