+X509_STORE *SSL_get0_verify_cert_store(const SSL *ssl) {
+  check_ssl_x509_method(ssl);
+  if (!ssl->config) {
+    return nullptr;
+  }
+  // This is the store |init_peer_verify_ctx| uses too.
+  if (ssl->config->cert->verify_store != nullptr) {
+    return ssl->config->cert->verify_store;
