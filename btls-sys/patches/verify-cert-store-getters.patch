+// the result beyond |ssl|'s own lifetime and thread. The caller owns the
+// result and must free it with |X509_STORE_CTX_free|.
+OPENSSL_EXPORT X509_STORE_CTX *SSL_new_peer_chain_verify_ctx(const SSL *ssl);
