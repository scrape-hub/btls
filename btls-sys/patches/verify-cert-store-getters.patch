+
+X509_STORE_CTX *SSL_new_peer_chain_verify_ctx(const SSL *ssl) {
+  check_ssl_x509_method(ssl);
+  X509_STORE *verify_store = SSL_get0_verify_cert_store(ssl);
+  if (verify_store == nullptr ||
+      SSL_get_verify_callback(ssl) != nullptr ||
+      SSL_CTX_get_cert_verify_callback(ssl->ctx.get()) != nullptr ||
+      X509_STORE_get_verify_cb(verify_store) != nullptr) {
+    // Any of these may use |ssl| and so cannot run where the result might be
+    // used.
+    return nullptr;
+  }
+
+  STACK_OF(X509) *cert_chain = SSL_get_peer_full_cert_chain(ssl);
+  if (cert_chain == nullptr || sk_X509_num(cert_chain) == 0) {
+    return nullptr;
+  }
+
+  UniquePtr<X509_STORE_CTX> ctx(X509_STORE_CTX_new());
+  if (!ctx) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_X509_LIB);
+    return nullptr;
+  }
+  if (!init_peer_verify_ctx(const_cast<SSL *>(ssl), ctx.get(),
+                           sk_X509_value(cert_chain, 0), cert_chain)) {
+    return nullptr;
+  }
+
+  return ctx.release();
+}
