+// init_peer_verify_ctx sets up `ctx` to verify `leaf` within `cert_chain` the
+// way the built-in verification does for `ssl`'s peer: the verify store,
+// ex_data, default purpose, verify parameters (including ECH's name
+// override) and, if set, a custom verify callback. `leaf` and `cert_chain`
+// are not copied or referenced; they, and `ssl`, must outlive `ctx`. Returns
+// false, with an error on the queue, if any step fails. Shared by
+// `ssl_crypto_x509_session_verify_cert_chain` and
+// `SSL_new_peer_chain_verify_ctx` so the two cannot silently diverge.
+static bool init_peer_verify_ctx(SSLImpl *ssl, X509_STORE_CTX *ctx, X509 *leaf,
+                                 STACK_OF(X509) *cert_chain) {
+  X509_STORE *verify_store = SSL_get0_verify_cert_store(ssl);
+  const char *name;
+  size_t name_len;
+  SSL_get0_ech_name_override(ssl, &name, &name_len);
+  if (!X509_STORE_CTX_init(ctx, verify_store, leaf, cert_chain) ||  //
+      !X509_STORE_CTX_set_ex_data(
+          ctx, SSL_get_ex_data_X509_STORE_CTX_idx(), ssl) ||  //
+      // We need to inherit the verify parameters. These can be determined by
+      // the context: if its a server it will verify SSL client certificates or
+      // vice versa.
+      !X509_STORE_CTX_set_default(
+          ctx, ssl->server ? "ssl_client" : "ssl_server") ||  //
+      // Anything non-default in "param" should overwrite anything in the ctx.
+      !X509_VERIFY_PARAM_set1(X509_STORE_CTX_get0_param(ctx),
+                              ssl->config->param) ||  //
+      // ClientHelloOuter connections use a different name.
+      (name_len != 0 &&  //
+       !X509_VERIFY_PARAM_set1_host(X509_STORE_CTX_get0_param(ctx), name,
+                                    name_len))) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_X509_LIB);
+    return false;
+  }
+
+  if (ssl->config->verify_callback) {
+    X509_STORE_CTX_set_verify_cb(ctx, ssl->config->verify_callback);
+  }
+
+  return true;
+}
