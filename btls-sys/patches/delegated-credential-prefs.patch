Adds SSL_CTX_set_delegated_credential_algorithm_prefs: the signature
algorithms of the delegated_credential extension as code points, including
ones this library cannot verify. NSS (Firefox) announces the ML-DSA schemes
there, which SSL_CTX_set_delegated_credentials cannot parse.

diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index d583291..edf02b5 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -1223,6 +1223,14 @@ OPENSSL_EXPORT int SSL_set_signing_algorithm_prefs(SSL *ssl,
 // by the client.
 OPENSSL_EXPORT int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx, const char *str);
 
+// SSL_CTX_set_delegated_credential_algorithm_prefs sets the signature
+// algorithms that clients on |ctx| announce in the delegated_credential
+// extension, as code points. Unlike |SSL_CTX_set_delegated_credentials|, it
+// keeps algorithms this library does not implement, such as the ML-DSA schemes
+// NSS announces. It returns one on success and zero on error.
+OPENSSL_EXPORT int SSL_CTX_set_delegated_credential_algorithm_prefs(
+    SSL_CTX *ctx, const uint16_t *prefs, size_t num_prefs);
+
 
 // Certificate and private key convenience functions.
 
diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
index 6a71110..2a8df11 100644
--- a/ssl/ssl_privkey.cc
+++ b/ssl/ssl_privkey.cc
@@ -960,3 +960,10 @@ int SSL_CTX_set_delegated_credentials(SSL_CTX *ctx, const char *str) {
   return set_sigalg_prefs(&ctx->delegated_credentials,
                           MakeConstSpan(sigalgs.data(), sigalgs.size()));
 }
+
+int SSL_CTX_set_delegated_credential_algorithm_prefs(SSL_CTX *ctx,
+                                                     const uint16_t *prefs,
+                                                     size_t num_prefs) {
+  return set_sigalg_prefs(&ctx->delegated_credentials, Span(prefs, num_prefs),
+                          /*allow_unknown=*/true);
+}
